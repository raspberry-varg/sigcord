{
  "name": "sigcord",
  "version": "1.2.1",
  "description": "Build interactive and stateful menus for Discord.",
  "keywords": [],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raspberry-varg/sigcord.git"
  },
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./jsx": {
      "default": "./dist/jsx-runtime.js",
      "types": "./dist/jsx-runtime.d.ts"
    },
    "./jsx-runtime": {
      "default": "./dist/jsx-runtime.js",
      "types": "./dist/jsx-runtime.d.ts"
    },
    "./jsx-dev-runtime": {
      "default": "./dist/jsx-runtime.js",
      "types": "./dist/jsx-runtime.d.ts"
    },
    "./components": {
      "default": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./context": {
      "default": "./dist/context/index.js",
      "types": "./dist/context/index.d.ts"
    },
    "./flow": {
      "default": "./dist/flow/index.js",
      "types": "./dist/flow/index.d.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "build": "tsc -p ./tsconfig.build.json",
    "prepack": "rm -rf ./dist/** && pnpm run build"
  },
  "dependencies": {
    "@sigcord/core": "workspace:*"
  },
  "devDependencies": {
    "@sigcord/jsx": "workspace:*"
  },
  "peerDependencies": {
    "@sigcord/jsx": "workspace:*"
  },
  "packageManager": "pnpm@10.11.0",
  "nx": {
    "targets": {
      "build": {},
      "typecheck": {},
      "lint": {
        "dependsOn": [
          "^lint"
        ]
      },
      "format": {
        "dependsOn": [
          "^format"
        ]
      },
      "test": {
        "dependsOn": [
          "^test"
        ],
        "executor": "nx:noop"
      },
      "yalc:push": {}
    }
  }
}
