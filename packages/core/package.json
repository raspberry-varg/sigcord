{
  "name": "@sigcord/core",
  "version": "7.2.1",
  "description": "Simple utility to have reactive, routed, and interactive Discord menus.",
  "directories": {
    "lib": "dist"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raspberry-varg/sigcord.git"
  },
  "scripts": {
    "test": "bun test",
    "lint": "eslint .",
    "format": "npx prettier --write src",
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepack": "pnpm run clean && pnpm run build"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@preact/signals-core": "^1.8.0"
  },
  "peerDependencies": {
    "discord.js": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "discord.js": "catalog:",
    "nx": "22.0.3",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./legacy": {
      "default": "./dist/legacy/index.js",
      "types": "./dist/legacy/index.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "nx": {},
  "publishConfig": {
    "access": "public"
  }
}
