{
  "name": "@sigcord/core",
  "version": "7.2.1",
  "description": "Simple utility to have reactive, routed, and interactive Discord menus.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raspberry-varg/sigcord.git"
  },
  "directories": {
    "lib": "dist"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./legacy": {
      "default": "./dist/legacy/index.js",
      "types": "./dist/legacy/index.d.ts"
    },
    "./flow": {
      "default": "./dist/components/flow/index.js",
      "types": "./dist/components/flow/index.d.ts"
    },
    "./components": {
      "default": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "build": "tsc -p ./tsconfig.build.json",
    "prepack": "rm -rf ./dist/** && pnpm run build"
  },
  "dependencies": {
    "@preact/signals-core": "^1.8.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "discord.js": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "discord.js": "catalog:"
  },
  "nx": {
    "targets": {
      "typecheck": {},
      "lint": {},
      "format": {},
      "yalc:push": {}
    }
  }
}
