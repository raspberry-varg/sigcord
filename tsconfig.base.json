{
  "compilerOptions": {
    /* Projects */
    "declaration": true,
    "declarationMap": true,

    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* JavaScript Support */
    "allowJs": true,

    /* Emit */
    "sourceMap": true,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "alwaysStrict": true,

    /* Completeness */
    "skipLibCheck": true,

    /* Tests and such */
    "types": ["bun"]
  }
}
